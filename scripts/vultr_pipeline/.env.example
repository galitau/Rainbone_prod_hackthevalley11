# Names only. Never commit values: the repository is public and .env* files are gitignored.
# Read from the process environment by scripts/vultr_pipeline/pipeline.py (upload) and by
# backend/routes_bones.py (GET /api/bones). Neither loads this file; export the variables in the
# shell that runs the command (see scripts/vultr_pipeline/README.md).

# Object Storage hostname from the Vultr console, with or without https://, e.g. https://<region>.vultrobjects.com
VULTR_S3_ENDPOINT=
# S3 access key and secret key of the Object Storage subscription.
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
# Bucket that holds ctpelvic1k/manifest.json and the bone files.
VULTR_S3_BUCKET=
