# Model and scan files are data: never convert their line endings, or their bytes stop matching
# the sha256 values recorded in each model manifest.
*.vtp -text
*.vtu -text
*.vtk -text
*.nrrd binary
*.nii binary
*.nii.gz binary
*.stl binary
# The AI endpoints' data files, whose sha256 is pinned next to them (<file>.sha256): keep them byte-exact too.
frontend/public/models/hfvalid-risk.json -text
frontend/public/models/hfvalid-femur/manifest.json -text
*.sha256 -text
