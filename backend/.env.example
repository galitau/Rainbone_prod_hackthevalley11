# Names only. Copy to backend/.env and fill in locally. backend/.env is gitignored (.env*);
# never commit keys or connection strings. Every variable is optional, and process environment
# variables override the file.

# Plain-language explanation (POST /api/explain). Without keys it answers with the offline template.
# Blank means the default:
#   AI_CHAIN      gemini,groq,template (comma list; template is always appended)
#   AI_OFFLINE    0 (1 = template only, no network)
#   GEMINI_MODEL  gemini-3.8-flash (gemini-3.5-flash-lite is tried after an HTTP error from it)
#   GROQ_MODEL    openai/gpt-oss-120b
AI_CHAIN=
AI_OFFLINE=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Simulation history. PostgreSQL connection string of a database with TimescaleDB, e.g. a
# Tiger Cloud service (copy it from the Tiger console, with its options such as ?sslmode=require).
# Unset: nothing is saved, GET /api/history answers 503 and POST /api/simulate is unchanged.
DATABASE_URL=

# Vultr Object Storage. The AI endpoints read their facts from the bucket's private clinical/ folder
# (scripts/vultr_pipeline/publish_clinical.py uploads it) and fall back to the bundled copies, saying so in
# `grounding`, when these are unset. GET /api/bones also uses them, but reads the process environment only.
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=

# Bone segmentation with FSL. Folder of an FSL install with bin/fslmaths and bin/connectedcomp,
# e.g. ~/fsl-bone after the README's micromamba command. Unset: numpy/scipy segment the bone
# (the same mask). uvicorn prints at startup which one is used.
FSLDIR=

# Vultr Object Storage (S3-compatible). Keep credentials in backend/.env only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
VULTR_ENDPOINT_URL=
VULTR_BUCKET_PATH=rainbowbone-bones/therapy
# Lowercase aliases are also accepted:
# aws_access_key_id=, aws_secret_access_key=, endpoint_url=

# Browser origins allowed to call the API (CORS). Blank means the default:
#   CORS_ALLOW_ORIGINS       http://localhost:3000,https://rainbone.health,https://www.rainbone.health
#                            (comma list; a value replaces the whole default list)
#   CORS_ALLOW_ORIGIN_REGEX  none (a regex the whole origin must match, e.g. for Vercel preview URLs)
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
